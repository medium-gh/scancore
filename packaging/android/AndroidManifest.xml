<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mediumdev.scancore"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates: open the downloaded APK in the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Asking to run unrestricted in the background (library update
         checks, downloads, reading aloud); the reader answers in the
         system's own dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Notifications for new chapters, announcements and updates
         (Android 13+ asks the reader). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fingerprint or face for the app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Casting: finding TVs and Chromecasts on the Wi-Fi (SSDP, mDNS). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Reading aloud with the screen off: a media-playback service with
         controls on the lock screen (ReadAloudService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Library update checks carry on after a restart (LibraryCheckJob). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- %%INSERT_PERMISSIONS -->
    <!-- Reading novels aloud: Android 11+ only lets apps see the
         text-to-speech engines they declare they look for. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <!-- Android TV: SCANCORE runs there with the remote (no touch screen
         needed) and shows in the TV's launcher. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- %%INSERT_FEATURES -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="SCANCORE"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupOnly="false">
        <activity
            android:name="org.qtproject.qt.android.bindings.QtActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="SCANCORE"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- One-tap "add repository" links from repository pages, and
                 SCANCORE's own links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="scancore" />
                <data android:scheme="tachiyomi" />
                <data android:scheme="mihon" />
                <data android:scheme="aniyomi" />
                <data android:scheme="lnreader" />
                <data android:scheme="cloudstreamrepo" />
            </intent-filter>

          <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

          <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />

          <!-- Keep Qt's event loop running when SCANCORE leaves the screen
               (Qt stops it by default), so library update checks,
               downloads and announcements carry on in the background. -->
          <meta-data
                android:name="android.app.background_running"
                android:value="true" />
        </activity>

        <!-- Sites' browser checks, in Android's web view. -->
        <activity
            android:name="com.mediumdev.scancore.BrowserCheck"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false" />

        <!-- The home-screen widget: Continue, and new chapters. -->
        <receiver
            android:name="com.mediumdev.scancore.HomeWidget"
            android:label="SCANCORE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scancore_widget_info" />
        </receiver>

        <service
            android:name="com.mediumdev.scancore.ReadAloudService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!-- Library update checks while SCANCORE is closed: the system's
             job, and SCANCORE without a window in a process of its own. -->
        <service
            android:name="com.mediumdev.scancore.LibraryCheckJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <service
            android:name="com.mediumdev.scancore.LibraryCheckService"
            android:process=":check"
            android:exported="false">
            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />
            <meta-data
                android:name="android.app.arguments"
                android:value="--library-check" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>
    </application>
</manifest>
