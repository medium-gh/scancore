<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same for cloud backups and for moving to a
     new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="file" path="extensions/" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="updates/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="file" path="extensions/" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="updates/" />
    </device-transfer>
</data-extraction-rules>
